# ── Server ───────────────────────────────────────────────
# Public HTTPS URL of this server (HTTPS terminated by your reverse proxy, e.g. Dokploy/Traefik)
PUBLIC_URL=https://wise.example.com

# ── Access ───────────────────────────────────────────────
# Wise user ids allowed to log in (comma-separated). Leave empty for the first login:
# the "Not allowed" page shows your id.
ALLOWED_WISE_USERS=

# Encrypts stored Wise API tokens: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── Writes ───────────────────────────────────────────────
# Two-step write tools (transfers you pay in the Wise app, recipients, cancellations).
# Nine informational tools by default (including temporary quote creation).
# Enable the five two-step account-changing tools only when explicitly needed.
WRITES_ENABLED=false
# Max amount per transfer in the source currency (empty = no limit)
MAX_TRANSFER_AMOUNT=

# ── Optional ─────────────────────────────────────────────
# Redirect hosts allowed for OAuth clients (default: claude.ai,claude.com,chatgpt.com,localhost,127.0.0.1)
# ALLOWED_REDIRECT_HOSTS=
# PORT=3000
# DATA_DIR=./data
